# Copy to .env.local for dev. Set same keys in Vercel → Settings → Environment Variables.
# Public catalogue reads the Google Sheet (or seed data without it).
SHEET_ID=1Brm4R7knfl6ZKP16Dwy2K7agkadW2Pfd87nAG67zWrc

# ---- Feature flags (both unset = current production: sheet site, no admin) ----
# ENABLE_BACKOFFICE=1   → /admin (Discord-gated books + catalogue manager)
# CATALOGUE_SOURCE=db   → public catalogue reads Postgres instead of the sheet
# Vercel: scope these per environment (e.g. on for Preview, off for Production).
# Discord login: create an app at https://discord.com/developers/applications → OAuth2.
# Redirect URL to add there: http://localhost:3100/api/auth/callback/discord
# (production: https://<your-domain>/api/auth/callback/discord)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Random string for session encryption (any long random value):
AUTH_SECRET=change-me-to-something-random-locally
# Comma-separated Discord user IDs allowed into /admin.
# Each person: Discord Settings → Advanced → Developer Mode ON → right-click own profile → Copy User ID.
ADMIN_DISCORD_IDS=

# Books database. Empty = embedded local file DB (.data/books, gitignored, zero setup).
# Production: create Postgres in Vercel Storage tab; it injects DATABASE_URL automatically.
DATABASE_URL=
